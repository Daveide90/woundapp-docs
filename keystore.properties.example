# Credenziali di firma release. COPIARE in `keystore.properties` (gitignorato) e compilare.
# NON committare mai keystore.properties né il file .jks/.keystore.
#
# Generare il keystore di produzione (una tantum, custodirlo in modo sicuro e con backup):
#   keytool -genkeypair -v -keystore wounddocs-release.jks \
#     -alias wounddocs -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=/percorso/assoluto/wounddocs-release.jks
storePassword=CAMBIA_ME
keyAlias=wounddocs
keyPassword=CAMBIA_ME
