<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Android 11+: rende visibili le app che gestiscono la scelta dei file -->
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <!--
          Da Android 11 la visibilità dei pacchetti è filtrata: senza queste voci
          getPackageInfo() lancia "not found" ANCHE se l'app di root è installata, e il
          controllo di RootDetector risultava sempre negativo (avviso mai mostrato).
        -->
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="me.phh.superuser" />
    </queries>

    <!--
      NESSUN permesso di accesso alle immagini: le foto si scelgono con il photo picker di
      sistema (PickMultipleVisualMedia) e con GET_CONTENT, che restituiscono un URI con
      autorizzazione temporanea e NON richiedono READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE.
      Dichiararli chiedeva all'utente più accesso del necessario (minimizzazione GDPR).
      L'app non dichiara nemmeno INTERNET: nessun dato può uscire dal dispositivo.
    -->

    <application
        android:name=".WoundManagementApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="WoundApp Docs"
        android:supportsRtl="true"
        android:theme="@style/Theme.WoundManagement">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.WoundManagement">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Apri un file di backup (.woundbackup) direttamente dal file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Best effort per nome file .woundbackup (alcuni content://) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.woundbackup" />
                <data android:pathPattern=".*\\..*\\.woundbackup" />
                <data android:pathPattern=".*\\..*\\..*\\.woundbackup" />
            </intent-filter>
            <!-- Ricevi un .woundbackup condiviso ("Invia a / Condividi con") -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
